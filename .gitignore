node_modules/
tmp/
.DS_Store
**/.DS_Store
output/pdf/*.tmp.pdf

# Keep only the current publication PDFs and the award criteria reference.
# Drafts, source attachments, backups, and internal workpapers stay local.
*.pdf
*.PDF
!/output/pdf/walton-county-fy2027-budget-book.pdf
!/output/pdf/walton-county-fy2027-budget-in-brief.pdf
!/GFOA budget award critera.pdf
# Documents the site links to (submitted budgets, program requests) must
# be published with it.
!/assets/documents/**/*.pdf

# Local tool downloads (e.g. a portable Node.js) -- never committed.
.tools/

# Working files under output/ (previews, review notes, exports) stay local;
# only the two publication PDFs above are tracked.
output/**
!output/
!output/pdf/
!/output/pdf/walton-county-fy2027-budget-book.pdf
!/output/pdf/walton-county-fy2027-budget-in-brief.pdf

# GFOA award reference forms (local only)
/GFOA budget award critera.pdf
/Budget-Criteria-Guide-Form*.pdf
